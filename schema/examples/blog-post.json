{
  "metadata": {
    "id": "blog-page",
    "name": "Blog Page",
    "pageType": "blog",
    "route": "/blog",
    "title": "Our Blog",
    "description": "Latest articles and updates"
  },
  "theme": {
    "primaryColor": "indigo-600",
    "darkMode": true
  },
  "dataSources": [
    {
      "id": "blogPosts",
      "endpoint": "get.blogPosts",
      "keyName": "posts",
      "limit": 10,
      "autoLoad": true
    }
  ],
  "actions": [
    {
      "id": "subscribe",
      "endpoint": "Newsletter.post_subscribe",
      "keyName": "subscription"
    }
  ],
  "sections": [
    {
      "type": "hero",
      "title": "Our Blog",
      "subtitle": "Stay updated with our latest articles and news",
      "className": "bg-gray-900 text-white py-20"
    },
    {
      "type": "posts",
      "dataSource": "blogPosts",
      "columns": 3,
      "className": "py-12"
    },
    {
      "type": "form",
      "title": "Subscribe to Newsletter",
      "subtitle": "Get the latest updates delivered to your inbox",
      "actionRef": "subscribe",
      "fields": [
        {
          "name": "email",
          "label": "Email Address",
          "type": "email",
          "placeholder": "Enter your email",
          "required": true
        }
      ],
      "buttons": [
        {
          "text": "Subscribe",
          "variant": "primary"
        }
      ]
    },
    {
      "type": "features",
      "title": "Why Read Our Blog?",
      "columns": 3,
      "items": [
        {
          "title": "Expert Insights",
          "content": "Learn from industry experts and thought leaders",
          "icon": "bi-lightbulb"
        },
        {
          "title": "Latest Trends",
          "content": "Stay ahead with the latest industry trends",
          "icon": "bi-graph-up"
        },
        {
          "title": "Practical Tips",
          "content": "Get actionable advice you can apply today",
          "icon": "bi-check-circle"
        }
      ]
    }
  ]
}
