{
  "metadata": {
    "id": "product-listing",
    "name": "Product Listing Page",
    "pageType": "category",
    "route": "/products",
    "title": "Our Products",
    "description": "Browse our product collection"
  },
  "theme": {
    "primaryColor": "indigo-600",
    "darkMode": true
  },
  "dataSources": [
    {
      "id": "productList",
      "endpoint": "get.products",
      "keyName": "products",
      "limit": 12,
      "autoLoad": true
    },
    {
      "id": "categories",
      "endpoint": "get.categories",
      "keyName": "categories",
      "autoLoad": true
    }
  ],
  "actions": [
    {
      "id": "addToCart",
      "endpoint": "Shop.post_carts",
      "keyName": "cart"
    },
    {
      "id": "filterProducts",
      "endpoint": "Shop.get_products",
      "keyName": "products"
    }
  ],
  "sections": [
    {
      "type": "hero",
      "title": "Our Products",
      "subtitle": "Discover our latest collection of high-quality products",
      "className": "bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-16"
    },
    {
      "type": "products",
      "dataSource": "productList",
      "columns": 4,
      "className": "py-12"
    },
    {
      "type": "cta",
      "title": "Need Help?",
      "content": "Contact our support team for assistance",
      "buttons": [
        {
          "text": "Contact Us",
          "href": "/contact",
          "variant": "primary"
        }
      ]
    }
  ]
}
